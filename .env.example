# Copy to .env, which is gitignored. Secrets live here or in the environment, never in config.toml.
# On the NAS this is /volume1/tools/immich-auto-rating/.env, read by docker-compose.yml as env_file.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=change-me

# The machine-learning container. LAN only, no internet exposure.
# On the NAS this is the container name on Immich's network, underscores and all, confirmed by
# `docker ps`: http://immich_machine_learning:3003
IMMICH_ML_URL=http://localhost:3003

# Read-only role on the Immich database, for the CLIP embeddings in smart_search.
# On the NAS, PGHOST is the Immich postgres container name, confirmed as immich_postgres.
PGHOST=localhost
PGPORT=5432
PGUSER=immich_ro
PGPASSWORD=change-me
PGDATABASE=immich

# Only needed outside the container. The compose file sets both for the container.
# STATE_DIR=./state
# CONFIG=./config.toml
