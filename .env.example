# Copy to .env, which is gitignored. Secrets live here or in the environment, never in config.toml.
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=change-me

# The machine-learning container. LAN only, no internet exposure.
IMMICH_ML_URL=http://localhost:3003

# Read-only role on the Immich database, for the CLIP embeddings in smart_search.
PGHOST=localhost
PGPORT=5432
PGUSER=immich_ro
PGPASSWORD=change-me
PGDATABASE=immich

# Where the SQLite state file lives. /data in the container.
STATE_DIR=./state

# Optional
# CONFIG=./config.toml
